{
  "expo": {
    "name": "MinFit",
    "slug": "minfit",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/app_icon_smaller.png",
    "userInterfaceStyle": "dark",
    "scheme": "minfit",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.minfit"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "expo-sharing"
    ]
  }
}
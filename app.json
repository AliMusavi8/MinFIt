{
  "expo": {
    "name": "MinFit",
    "slug": "minfit",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/Mobile_app_icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "minfit",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081A35",
        "foregroundImage": "./assets/android-icon-transparent.png",
        "backgroundImage": "./assets/mobile-app-icon-adaptive.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.minfit"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "expo-sharing"
    ]
  }
}
